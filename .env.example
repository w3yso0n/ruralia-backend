# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ruralia

# Servidor
PORT=3001
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# Firebase Admin SDK
FIREBASE_PROJECT_ID=tu-proyecto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@tu-proyecto-firebase.iam.gserviceaccount.com
# La clave privada debe ir entre comillas; los saltos de línea como \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA\n-----END PRIVATE KEY-----\n"

# Redis (cola Bull para procesamiento asíncrono)
REDIS_HOST=localhost
REDIS_PORT=6379

# Archivos
RUTA_SUBIDAS=./subidas
TAMANO_MAXIMO_ARCHIVO=52428800
